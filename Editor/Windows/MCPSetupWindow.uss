/* MCP Setup Window Styles */
#root-container { padding: 20px; flex-grow: 1; }
.setup-header { flex-direction: row; align-items: center; margin-bottom: 8px; }
.setup-logo { width: 34px; height: 34px; margin-right: 12px; flex-shrink: 0; }
.setup-title-group { flex-direction: column; justify-content: center; flex-shrink: 1; }
.setup-brand-subtitle { margin-top: 2px; font-size: 10px; color: rgba(170, 180, 200, 0.9); }
.setup-header .title { margin-bottom: 0; padding: 0; background-color: rgba(0, 0, 0, 0); flex-shrink: 1; white-space: normal; }
#dependency-list { margin-top: 8px; }
.dependency-item { margin-bottom: 12px; }
.dependency-row { flex-direction: row; align-items: center; }
.dependency-name { -unity-font-style: bold; min-width: 150px; }
.dependency-row .status-indicator-small { margin-left: 8px; }
.dependency-details { margin-left: 0px; margin-top: 4px; }
#status-message-container { margin-top: 16px; }
#status-message { white-space: normal; }
#installation-section { margin-top: 16px; padding: 12px; background-color: rgba(0, 0, 0, 0.05); border-radius: 6px; border-width: 1px; border-color: rgba(0, 0, 0, 0.2); display: none; }
.installation-container { flex-shrink: 1; min-width: 0; }
.installation-title { -unity-font-style: bold; margin-bottom: 8px; }
#installation-instructions { white-space: normal; margin-bottom: 4px; }
.install-links-row { flex-direction: row; flex-wrap: wrap; }
.install-link-button { flex-grow: 1; min-width: 180px; margin-top: 0; }
.button-container { flex-direction: row; align-items: center; justify-content: flex-end; flex-wrap: wrap; }
.setup-button { min-width: 96px; height: 28px; padding-left: 12px; padding-right: 12px; margin-left: 8px; margin-top: 4px; }
.button-container .setup-button { width: auto; flex-grow: 0; }
.description-text { margin-bottom: 12px; }
